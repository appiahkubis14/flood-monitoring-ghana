# ── Django core ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_ADMINS=Admin Name:admin@floodwatch.gh

# ── Study area (Accra, Ghana — WGS84 bbox) ────────────────────────────────────
ACCRA_BBOX_MINLON=-0.30
ACCRA_BBOX_MINLAT=5.50
ACCRA_BBOX_MAXLON=-0.05
ACCRA_BBOX_MAXLAT=5.70

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
DB_NAME=floodwatch
DB_USER=postgres
DB_PASSWORD=sak@2001server
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSL_MODE=require

# ── Redis (Celery broker + Channels + cache) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Twilio (WhatsApp / SMS alerts) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ── MQTT (ESP32 sensor ingestion) ─────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=floodwatch/sensors
SENSOR_OFFLINE_THRESHOLD_MINUTES=30

# ── PyGeoVision satellite monitoring ──────────────────────────────────────────
PYGEOVISION_DATA_DIR=
PYGEOVISION_PROVIDERS=planetary_computer
PYGEOVISION_CLOUD_COVER_MAX=20
PYGEOVISION_S2_BANDS=B02,B03,B04,B08,B11,B12
PYGEOVISION_SCAN_DAYS_BACK=7

# ── Alerts ─────────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_MINUTES=30

# ── Email (admin notifications, production only) ──────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@floodwatch.gh

# ── Optional S3 media storage (production) ────────────────────────────────────
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
